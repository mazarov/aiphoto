# Supabase (скопировать из photo2sticker-bot/.env)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.dockhost.net
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Яндекс ID — опционально для /api/public-config (UI AuthModal больше не использует YaAuthSuggest)
NEXT_PUBLIC_YANDEX_OAUTH_CLIENT_ID=
# Опционально; по умолчанию NEXT_PUBLIC_SUPABASE_URL/auth/v1/callback
# NEXT_PUBLIC_YANDEX_OAUTH_REDIRECT_URI=https://xxx.dockhost.net/auth/v1/callback

# Публичные URL медиа карточек через Storage Image Transformation (imgproxy + ENABLE_IMAGE_TRANSFORMATION на storage-api). Без этого — обычный /object/public/
# NEXT_PUBLIC_SUPABASE_STORAGE_IMAGE_TRANSFORM=1

# Gemini
# Landing uses this for vibe extract/expand and same-origin /api/extension/analyze.
# Image generation uses the same variables in the separate web-generation-worker service.
GEMINI_API_KEY=
# Optional generateContent-compatible proxy; DB photo_app_config.gemini_use_proxy controls use.
# GEMINI_PROXY_BASE_URL=https://your-proxy.example.com
# Site analyze: 10 free/UTC day then 1 landing credit. DB aiid_app_config.analyze_free_per_day / analyze_credit_cost.
# Grok Bot scout analyze: POST /api/scout/analyze — no auth, 200 successful / UTC day on this route only.
# EXTENSION_RATE_LIMIT_CONFIG_TTL_MS=120000
# Analyze emits sanitized request/response diagnostics; image bytes and API keys are never logged.
# Optional local prompt-remix model (default: gemini-2.5-flash)
# GEMINI_PROMPT_REMIX_MODEL=gemini-2.5-flash
# Hybrid visual search (text → image) for /api/search and listing ?q= (birthday cluster). Off until embeddings are backfilled.
# SEARCH_VISUAL_ENABLED=0
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# SEARCH_VISUAL_GENERATION=1
# SEARCH_VISUAL_TIMEOUT_MS=800
# SEARCH_VISUAL_TASK_PREFIX=1
# GEMINI_EMBEDDING_USE_PROXY=1
# SEARCH_VISUAL_IP_DAILY_LIMIT=60
# SEARCH_VISUAL_SYSTEM_DAILY_LIMIT=10000
# SEARCH_VISUAL_GLOBAL_DAILY_LIMIT=4000
# SEARCH_VISUAL_GEMINI_CONCURRENCY=4
# Durable queue admission kill switch. Disable before maintenance/migration.
GENERATION_QUEUE_ENABLED=true

# STV / embed / extension: correlate logs across upload → extract → expand → generate
# Temporary web-embed guest mode: silent Supabase anonymous session + free generation.
# Defaults to enabled in development and disabled in production when unset.
# Requires GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=true on the Supabase Auth service.
# Optional auth-service limit: GOTRUE_RATE_LIMIT_ANONYMOUS_USERS=30 (per IP/hour).
# STV_GUEST_MODE=1
# Optional: existing landing_users.id used as DB owner for guest generations.
# If unset, API picks the oldest landing_users row (requires at least one OAuth login).
# STV_GUEST_OWNER_USER_ID=

# Temporary: card inline generate without credits (upload + /api/generate + poll).
# Requires logged-in allowlisted session email (default azarov.maxim@gmail.com).
# Generations are owned by that user (visible on /generations). No anonymous open-debug.
# Default on for allowlisted users; set =0 to force off. =1 is explicit on.
# STV_OPEN_GENERATE_DEBUG=0
# Optional comma-separated emails for internal generate UI + open-debug API.
# INTERNAL_GENERATE_ALLOWLIST=azarov.maxim@gmail.com

# Client sends header X-STV-Pipeline-Trace (UUID) and pipelineTraceId on POST /api/generate; server logs tag [stv.pipeline] with pipelineTrace.
# GEMINI_VIBE_DEBUG=1 — redacted Gemini request bodies on vibe extract (see landing/src/lib/gemini-vibe-debug-log.ts)
# Optional vibe model overrides if photo_app_config row missing (defaults: extract=gemini-2.5-pro, expand=gemini-2.5-flash)
# GEMINI_VIBE_EXTRACT_MODEL=gemini-2.5-pro
# GEMINI_VIBE_EXPAND_MODEL=gemini-2.5-flash
# One-shot extract: single vision call → { "prompt" }; expand uses vibes.prefilled_generation_prompt (default off; DB photo_app_config.vibe_one_shot_extract_prompt overrides)
# VIBE_ONE_SHOT_EXTRACT_PROMPT=false

# Optional: OpenAI for vibe extract/expand (photo_app_config vibe_extract_llm / vibe_expand_llm = openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# VIBE_EXTRACT_LLM=gemini
# VIBE_EXPAND_LLM=openai
# VIBE_OPENAI_EXTRACT_MODEL=gpt-4o
# VIBE_OPENAI_EXPAND_MODEL=gpt-4.1-mini

# Runtime origin for server-side internal callbacks
NEXT_PUBLIC_SITE_URL=https://promptshot.ru

# YooKassa one-time token checkout (server-only; never prefix with NEXT_PUBLIC_)
# Runtime feature flag. Keep yookassa for instant rollback.
PAYMENT_PROVIDER=yookassa
# Optional production canary while PAYMENT_PROVIDER=yookassa.
# Matching authenticated emails use Robokassa; everyone else stays on YooKassa.
# ROBOKASSA_CANARY_EMAILS=admin@example.com
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Robokassa modal iFrame checkout (server-only)
# ResultURL: https://promptshot.ru/api/payments/robokassa/result (POST)
# SuccessURL: https://promptshot.ru/payment/robokassa/success (GET)
# FailURL: https://promptshot.ru/payment/robokassa/fail (GET)
ROBOKASSA_MERCHANT_LOGIN=
# Production passwords from Robokassa technical settings
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
# Separate test passwords; required when ROBOKASSA_TEST_MODE=1
ROBOKASSA_TEST_PASSWORD_1=
ROBOKASSA_TEST_PASSWORD_2=
# Must match the algorithm selected in Robokassa technical settings: md5|sha256|sha512
ROBOKASSA_HASH_ALGORITHM=sha256
# 1 only for Robokassa test payments
ROBOKASSA_TEST_MODE=0
# Receipt tax code configured for the merchant, e.g. none, vat0, vat10, vat20
ROBOKASSA_RECEIPT_TAX=none

# Yandex Metrika Measurement Protocol token (counter 107703100 → Security → Measurement Protocol).
# Server-only. Without it, purchases are not sent to Direct server-side.
# YANDEX_METRIKA_MP_TOKEN=

# Shared secret for POST /api/cron/yookassa-reconcile, /api/cron/visual-embeddings, /api/cron/mail-outbox
CRON_SECRET=

# Yandex Cloud Postbox (RF, call directly — no GEMINI_PROXY). Empty keys → cron no-ops.
# Default quota is 200 emails/24h and 1 email/sec until YC raises it.
# POSTBOX_ENDPOINT=https://postbox.cloud.yandex.net
# POSTBOX_REGION=ru-central1
# POSTBOX_ACCESS_KEY_ID=
# POSTBOX_SECRET_ACCESS_KEY=
# POSTBOX_FROM=noreply@promptshot.ru
# POSTBOX_REPLY_TO=support_ru@promptshot.ru
# HMAC for /unsubscribe and List-Unsubscribe one-click
# MAIL_UNSUBSCRIBE_SECRET=
# Bearer or X-Postbox-Secret for POST /api/mail/postbox-events
# POSTBOX_WEBHOOK_SECRET=
# Until DKIM/quota are ready, cron sends only these addresses (comma/semicolon)
# POSTBOX_TEST_ALLOWLIST=azarov.maxim@gmail.com

# Marketing page /extension-stv — primary CTA (optional; default #stv-chrome-store)
# NEXT_PUBLIC_STV_CHROME_STORE_URL=https://chromewebstore.google.com/detail/...

# /foto-v-promt/ analyze is same-origin (/api/extension/analyze).
# The external origin remains in use for prompt remix and links to imageprompt.tools.
# NEXT_PUBLIC_IMAGEPROMPT_API_ORIGIN=https://imageprompt.tools
# NEXT_PUBLIC_AI_IMAGE_DESCRIBER_CHROME_URL=https://chromewebstore.google.com/detail/ai-image-describer/bebnhekhnoaacojmbjoajndkankmppoj
# Dev remix uses /api/imageprompt-proxy/extension/remix unless NEXT_PUBLIC_IMAGEPROMPT_DIRECT=1.
# Full URL or bare @username / bot username (API normalizes to https://t.me/...)
TELEGRAM_BOT_LINK=https://t.me/your_payment_bot

# CORS allowlist for chrome extension
# Preferred: set extension id explicitly
CHROME_EXTENSION_ID=abcdefghijklmnopabcdefghijklmnop
# Or use explicit CSV list:
# CORS_ALLOWED_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# Built-in admin analytics/history API allowlist (comma/semicolon separated).
# Keep empty to deny all admin access.
# ANALYTICS_ADMIN_EMAILS=admin@example.com

# Public "Try this look" CTA on prompt cards
# NEXT_PUBLIC_ENABLE_TRY_THIS_LOOK=true
