{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "..",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  // COPY every path below in Dockerfile.worker and web-generation-worker/Dockerfile.
  "include": [
    "src/**/*",
    "../landing/src/lib/image-generation-prompt.ts",
    "../landing/src/lib/grok-image-prompt.ts",
    "../landing/src/lib/seedream-image-prompt.ts",
    "../landing/src/lib/generation-edit-contract.ts",
    "../landing/src/lib/camera-orbit.ts",
    "../landing/src/lib/video-motion-prompt.ts",
    "../landing/src/lib/user-generation-photo-paths.ts"
  ]
}
