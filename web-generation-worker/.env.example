APP_ENV=prod
PORT=3003
SUPABASE_SUPABASE_PUBLIC_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_PROXY_BASE_URL=
XAI_API_KEY=
# Same origin as GEMINI_PROXY_BASE_URL + allowlisted prefix. Empty = Grok jobs fail; no direct api.x.ai fallback.
# Example: https://gemini-proxy.example.com/u/api.x.ai
XAI_BASE_URL=
VIBE_ATTACH_REFERENCE_IMAGE_TO_GENERATION=true
WORKER_ID=
WORKER_PROCESSING_ENABLED=true
WORKER_CONCURRENCY=10
WORKER_GLOBAL_CAP=50
WORKER_PER_USER_CAP=3
WORKER_LEASE_SECONDS=180
WORKER_VIDEO_CONCURRENCY=2
WORKER_VIDEO_GLOBAL_CAP=8
WORKER_VIDEO_PER_USER_CAP=1
WORKER_VIDEO_LEASE_SECONDS=600
WORKER_VIDEO_POLL_MS=5000
WORKER_VIDEO_TIMEOUT_MS=480000
WORKER_POLL_MS=1000
WORKER_HEARTBEAT_MS=30000
WORKER_REAPER_MS=30000
WORKER_REAPER_LIMIT=100
WORKER_SHUTDOWN_GRACE_MS=30000
