      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "legendFormat": "{{service}}", "expr": "sum by (service) (count_over_time({env=\"${env}\"} | json | event=~\"process_start|worker_started\" [1h]))" }]
    },
    {
      "id": 2, "type": "timeseries", "title": "Сайт: ok за 5 мин",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
