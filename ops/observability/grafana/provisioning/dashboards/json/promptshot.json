  "panels": [
    { "id": 100, "type": "row", "title": "Тех", "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Сайт: uptime 24 ч",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 0.995 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "auto" },
      "targets": [{ "refId": "A", "expr": "avg_over_time({service=\"probe\",env=\"${env}\"} | json | event=`probe` | target=`landing` | unwrap ok [24h])" }]
    },
    {
      "id": 5, "type": "stat", "title": "Генерации: успех за 1 ч",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "loki", "uid": "loki" },
