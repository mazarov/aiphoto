# Copy to .cursor/yandex-seo.env (gitignored) and fill in real values there.
# Yandex OAuth app: https://oauth.yandex.ru/client/new
# Scopes: metrika:read, webmaster:hostinfo, webmaster:verify
# Token:
#   https://oauth.yandex.ru/authorize?response_type=token&client_id=YOUR_CLIENT_ID
#
# Required:
#   YANDEX_SEO_TOKEN=<oauth_access_token>
# Optional:
#   YANDEX_WEBMASTER_HOST_URL=https://promptshot.ru
#   YANDEX_METRIKA_COUNTER_ID=107703100
