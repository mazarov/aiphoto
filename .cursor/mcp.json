    },
    "yandex-webmaster": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/src/standalone/mcp-yandex-webmaster.mjs"],
      "envFile": "${workspaceFolder}/.cursor/yandex-seo.env"
    }
  }
}
